PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/zencode
JWT_SECRET=change-me-jwt-secret
REFRESH_SECRET=change-me-refresh-secret
CORS_ORIGINS=http://localhost:3000

# Optional: real AI responses (OpenAI-compatible API). Canned replies are used when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: PostgreSQL is only health-checked when POSTGRES_HOST is set
# POSTGRES_HOST=localhost
